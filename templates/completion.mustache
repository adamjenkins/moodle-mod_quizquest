{{!
    @template mod_quizquest/completion

    Completion banner shown when the quest ends successfully.

    Context variables required for this template:
    * title - completion heading string
    * message - completion detail string
    * newattempturl - URL to start a new attempt (empty string if no more attempts allowed)
    * newattemptlabel - label for the new attempt button

    Example context (json):
    {
        "title": "Congratulations!",
        "message": "You completed the quest.",
        "newattempturl": "https://example.com/mod/quizquest/view.php?id=2",
        "newattemptlabel": "Start a new attempt"
    }
}}
<div class="alert alert-success d-flex align-items-center gap-3 mt-3" role="alert">
    {{#pix}} i/valid, core {{/pix}}
    <div>
        <strong>{{title}}</strong>
        <p class="mb-0">{{message}}</p>
    </div>
</div>
{{#newattempturl}}
<a href="{{newattempturl}}" class="btn btn-primary mt-2">{{newattemptlabel}}</a>
{{/newattempturl}}
